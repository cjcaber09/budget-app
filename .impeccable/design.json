        "css": "button{display:flex;align-items:center;gap:12px;padding:18px 0;width:100%;border:0;border-bottom:1px solid var(--border);background:transparent;color:var(--text);text-align:left}.icon{display:grid;place-items:center;width:40px;height:40px;border-radius:10px;background:var(--surfaceAlt)}.info{flex:1;min-width:0;display:grid;gap:2px}small{color:var(--muted)}b{font-variant-numeric:tabular-nums}"
