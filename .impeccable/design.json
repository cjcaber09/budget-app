        "css": "article{padding:18px 0;border-bottom:1px solid var(--border);color:var(--text)}div{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px;margin:10px 0}span{color:var(--success)}output{font-variant-numeric:tabular-nums;color:var(--muted)}meter{width:100%;height:4px;accent-color:var(--success)}"
